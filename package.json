{
  "name": "@ht-rnd/merge-conflict-viewer",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "A three-pane (current | result | incoming) merge conflict viewer for JSON, for React",
  "author": "",
  "license": "Apache-2.0",
  "keywords": [
    "react",
    "merge",
    "conflict",
    "diff",
    "viewer",
    "json",
    "comparison"
  ],
  "main": "./dist/lib/main.cjs",
  "module": "./dist/lib/main.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lib/main.es.js",
      "require": "./dist/lib/main.cjs"
    },
    "./styles": "./dist/merge-conflict-viewer.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": ""
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "vite --host --logLevel info",
    "build": "biome ci && vite build",
    "build:ci": "vite build",
    "check": "biome check --write",
    "check:ci": "biome ci",
    "format": "biome format --write",
    "preview": "vite preview",
    "test": "vitest run",
    "test:package": "npm run build:ci && node scripts/smoke-test.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.574.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^5.0.3"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
