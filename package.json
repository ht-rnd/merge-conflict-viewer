{
  "name": "@ht-rnd/merge-conflict-viewer",
  "private": false,
  "version": "1.0.1",
  "type": "module",
  "description": "Headless merge conflict viewer for JSON (React hooks and merge model), with a shadcn/ui registry component",
  "author": "ht-rnd",
  "license": "Apache-2.0",
  "keywords": [
    "react",
    "merge",
    "conflict",
    "diff",
    "viewer",
    "json",
    "comparison",
    "headless",
    "shadcn",
    "shadcn-registry"
  ],
  "main": "./dist/lib/main.cjs",
  "module": "./dist/lib/main.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lib/main.es.js",
      "require": "./dist/lib/main.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ht-rnd/merge-conflict-viewer.git"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "npm --prefix demo run dev",
    "build": "biome ci && vite build",
    "build:ci": "vite build",
    "check": "biome check --write",
    "check:ci": "biome ci",
    "format": "biome format --write",
    "test": "vitest run",
    "test:demo": "npm --prefix demo run test",
    "test:package": "npm run build:ci && node scripts/smoke-test.mjs",
    "registry:build": "npm --prefix demo run registry:build",
    "test:registry": "node scripts/registry-test.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^29.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^5.0.3"
  },
  "sideEffects": false
}
